# Shared configuration for BOTH holonbridge (the REST server) and
# holonbridge_mcp (the MCP layer, stdio or remote). One file, loaded
# automatically by both — see holonbridge/envfile.py.
#
# Discovery order:
#   1. HOLONBRIDGE_ENV_FILE, an absolute path — set this when the process
#      is launched somewhere that isn't the project directory (Claude
#      Desktop's own config, a scheduled task, a service).
#   2. .env in the current working directory, otherwise — what you get for
#      free by running `holonbridge` or `holonbridge_mcp` from here.
# A real environment variable (set with $env:X = ... before running, or in
# a launcher's own env block) always wins over anything in this file.
#
# NOTE: NGROK_AUTHTOKEN below is a partial exception to "loaded by both" —
# it's read directly by scripts/holonbridge-ctl.sh (a plain grep of this
# file, not Python's envfile.py), since ngrok itself is a separate binary
# neither holonbridge nor holonbridge_mcp ever invokes. Kept in this file
# anyway so there's one place secrets for this stack live, not two.

# =====================================================================
# holonbridge — the REST server (port 3031)
# =====================================================================

# --- bridge ---------------------------------------------------------------
HOLONBRIDGE_HOST=127.0.0.1
HOLONBRIDGE_PORT=3031

# --- backend --------------------------------------------------------------
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=ds

# --- auth -----------------------------------------------------------------
# PowerShell (Windows PowerShell 5.1 — use ::Create().GetBytes($bytes) if
# ::GetBytes(32) as a static call isn't found; that overload needs .NET 6+,
# i.e. PowerShell 7+):
#   $bytes = New-Object byte[] 32
#   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
BEARER_TOKEN=

# --- identity-bound credentials (optional; replaces the shared token) -------
# BEARER_TOKEN above is SHARED: whoever holds it can send any
# x-holon-animus-id header and be that Person, admin included. These give
# each caller a credential that proves who it is. Tokens must be >= 24
# characters (use the generators above); one token may hold only one role.
#
#   IDENTITY_TOKENS  token=identity pairs. A request bearing one of these IS
#                    that identity (a header naming anyone else is a 403).
#                    Give each service and person their own. The identity is
#                    always resolved as a GitHubIdentity, so a service account
#                    must exist in the dataset as a Person whose GitHubIdentity
#                    identifier equals the bound name (create it like any other
#                    Person); the x-holon-animus-type header is ignored.
#   PROXY_TOKENS     tokens for a TRUSTED PROXY that has itself verified the
#                    caller (the MCP remote, via OAuth). Only these may assert
#                    an identity through the header. Set the MCP process's own
#                    HOLONBRIDGE_MCP_TOKEN (or, failing that, BEARER_TOKEN)
#                    to one of them.
#   ALLOW_LEGACY_BEARER  keep accepting BEARER_TOKEN (default true, so nothing
#                    changes on upgrade). Set false once every caller has moved
#                    to one of the above. Setting it false with neither
#                    IDENTITY_TOKENS nor PROXY_TOKENS configured refuses to
#                    start: no credential could ever authenticate.
#
# IDENTITY_TOKENS=<token>=web-frontend-service,<token>=alice
# PROXY_TOKENS=<token>
# ALLOW_LEGACY_BEARER=true

# --- one token, one role (enforced at startup) ----------------------------
# Every token has exactly ONE role: legacy (BEARER_TOKEN), identity (an
# IDENTITY_TOKENS entry) or proxy (a PROXY_TOKENS entry). The same string in
# two of them -- or twice in one list -- and the REST server refuses to
# start, naming both roles, rather than guess whether the animus header may
# override it. (ALLOW_LEGACY_BEARER=false with no IDENTITY_TOKENS or
# PROXY_TOKENS also refuses to start.)
#
# What follows for the MCP: it is a proxy, so its token goes in PROXY_TOKENS
# and must NOT be the BEARER_TOKEN. Give it its own, as HOLONBRIDGE_MCP_TOKEN
# (below). And since a real environment variable beats this file, a stale
# machine-level BEARER_TOKEN overrides a blank BEARER_TOKEN= here; remove it
# from the environment rather than relying on the blank.

# --- claiming an unprovisioned dataset (optional) -------------------------
# A dataset that exists in Fuseki but has no owner or admin answers every
# gated route with 401. DATASET_CLAIMANTS says who may fix that in-band, with
# POST /admin/dataset/initialise (MCP tool: initialise_dataset): they become
# the dataset's first owner.
#
#   DATASET_CLAIMANTS  comma-separated identifiers. Empty (the default) turns
#                      the in-band claim off; holonbridge-bootstrap-admin is
#                      then the only way in.
#
# An identifier is matched against who the caller provably is: the identity
# bound to an IDENTITY_TOKENS token, or the identity a PROXY_TOKENS caller
# asserts (for the MCP over OAuth, the GitHub login). The legacy BEARER_TOKEN
# and an open (no-token) deployment can never claim, whatever header they
# send. Being listed is not enough on its own: the dataset must also have no
# owner and no admin.
#
# Refusals: 403 not eligible (the same answer whether or not the dataset is
# open), 404 unknown_dataset (the server does not host it -- create it first),
# 409 dataset_already_claimed. A 409 is audited as a refusal, like a 401/403.
# DATASET_CLAIMANTS=alice

# --- outbound webhooks (optional) ------------------------------------------
# Projection hooks with delivery=webhook make the bridge POST to a URL somebody
# typed in. By default only https endpoints whose every resolved address is
# public are allowed (no loopback, private, link-local or metadata addresses),
# credentials in the URL are refused and redirects are not followed.
#
#   WEBHOOK_ALLOWLIST  comma-separated hosts: `host`, `host:port` or
#                      `*.example.com` (subdomains, not the bare domain). When
#                      set, ONLY these hosts can be reached, and a listed host
#                      is exempt from the https / public-address rules -- the
#                      way to point a hook at a service on your own network.
#                      Lives in the environment, not the graph, because anyone
#                      who can write a hook can write the graph.
# WEBHOOK_ALLOWLIST=n8n.internal:5678,*.hooks.example.com

# --- ingest from a URL (optional) -------------------------------------------
# POST /ingest with a source_url (MCP tool: ingest) makes the bridge fetch a URL
# the caller chose. It follows the webhook rules: https only, public addresses
# only, no credentials in the URL, and every redirect hop is checked too.
#
#   FETCH_ALLOWLIST  comma-separated hosts, same syntax as WEBHOOK_ALLOWLIST
#                    (`host`, `host:port`, `*.example.com`). When set, ONLY these
#                    hosts can be fetched from, and a listed host is exempt from
#                    the https / public-address rules -- the way to ingest from a
#                    service on your own network. Environment only, because
#                    anyone who can call /ingest could otherwise widen it.
#   FETCH_MAX_BYTES  largest response read, after decompression (default
#                    10485760 = 10 MiB). Larger ones fail the ingest.
# FETCH_ALLOWLIST=data.example.org,*.files.example.com
# FETCH_MAX_BYTES=10485760
#
#   JSON-LD input and output (see README, "JSON-LD").
#   JSONLD_FETCH_CONTEXTS  false (default): a payload that names a remote @context
#                          is refused. true: contexts are fetched through the
#                          FETCH_ALLOWLIST egress policy and inlined.
#   JSONLD_MAX_BYTES       largest JSON-LD document read or produced (default 5242880)
#   JSONLD_OUTPUT_ENGINE   rdflib (default) or jena. jena asks Fuseki for
#                          application/ld+json and falls back to rdflib.
# JSONLD_FETCH_CONTEXTS=false
# JSONLD_MAX_BYTES=5242880
# JSONLD_OUTPUT_ENGINE=rdflib

# --- named triggers (optional) ----------------------------------------------
# A trigger registered through the API records who armed it, and that person's
# access is re-checked when it fires. A trigger with no recorded person was
# hand-authored and keeps running as before. Set this to refuse to fire any
# trigger that cannot be traced to a person.
# TRIGGERS_REQUIRE_DEFINER=true

# --- agent endpoints (optional) --------------------------------------------
# The bridge can send a task to an external agent (hb:AgentEndpoint, see the
# README's "Agent endpoints" note). Every call waits for a person's approval
# unless an endpoint and a trigger both say otherwise, and an agent's answer is
# only ever proposed, never written. Both settings below live in the
# environment, not the graph, because anyone who can write an endpoint can
# write the graph.
#
#   AGENT_ALLOWLIST          same syntax as WEBHOOK_ALLOWLIST (`host`,
#                            `host:port`, `*.example.com`). An endpoint that
#                            carries a credential is refused unless its host is
#                            listed here: a secret is only ever sent to a host
#                            the operator named. Endpoints with no credential
#                            fall back to the default egress rules (https,
#                            public addresses only) when this is empty; when it
#                            is set, only listed hosts can be reached.
#   AGENT_CREDENTIAL_PREFIX  an endpoint names its secret as `env:NAME`, and
#                            NAME must start with this (default HB_AGENT_), so
#                            registering an endpoint can never be used to read
#                            an unrelated variable such as a database password.
#                            Set the secrets themselves here, e.g.
#                            HB_AGENT_TRIAGE_KEY=...
#   AGENT_MAX_OPEN_CALLS     most calls open to one endpoint at once (waiting for
#                            approval, queued, or being sent). Further requests
#                            get 429 and a trigger that matches more nodes than
#                            fit records `failed` for the rest. Default 200;
#                            0 = no limit.
# AGENT_ALLOWLIST=agents.example.com
# AGENT_MAX_OPEN_CALLS=200
# AGENT_CREDENTIAL_PREFIX=HB_AGENT_
# HB_AGENT_TRIAGE_KEY=change-me

# --- creating a dataset (optional) ----------------------------------------
# POST /datasets (MCP tool: create_dataset) creates a new, empty dataset on the
# backend, persistent (TDB2) or in-memory. Create only: the bridge has no way
# to drop one, so removing a dataset stays a manual step in Fuseki.
#
#   DATASET_CREATORS   comma-separated identifiers. Empty (the default) turns
#                      creation off. A separate list from DATASET_CLAIMANTS on
#                      purpose: creating a dataset allocates storage on a
#                      Fuseki shared by every dataset, which admin on any one
#                      dataset does not imply. Same standard as claiming: an
#                      identity token, or a proxy asserting an identity, never
#                      the legacy BEARER_TOKEN or an open deployment.
#   FUSEKI_CONFIG_DIR  (existing setting) Fuseki's configuration directory. Also
#                      what lets a created dataset get a /shacl endpoint: Fuseki's
#                      admin API cannot create one with it, so the bridge appends
#                      the endpoint to the dataset's config file, and it takes
#                      effect when Fuseki restarts. Unset: datasets are still
#                      created, without a /shacl endpoint.
#   SNAPSHOT_DIR       directory on the BRIDGE's host where snapshot_dataset writes
#                      (and restore_dataset reads) one subdirectory per dataset:
#                      a checkpoint to take before restarting Fuseki, so an
#                      in-memory dataset can be put back. Unset turns both off.
#   SNAPSHOT_KEEP     how many snapshots to keep per dataset (default 5); older
#                      ones are removed only after a new one is written.
#   SNAPSHOT_MAX_BYTES refuse a snapshot larger than this (default 50000000);
#                      the bridge reads the whole dataset into memory to write it.
#   SNAPSHOT_MAX_AGE_DAYS  remove snapshots and exports older than this many days after
#                      a new one is written; the newest is always kept. 0 (default) = no
#                      age limit, only SNAPSHOT_KEEP applies.
#   EXPORT_MAX_BYTES   refuse an export whose uncompressed TriG would exceed this
#                      (default 200000000). Memory use is the largest single graph.
#   EXPORT_SIGNING_KEY secret (32+ characters) that signs the expiring download links for
#                      exports. Unset turns links off; exports are still written under
#                      SNAPSHOT_DIR/{dataset}/exports/. Treat it like a password.
#   EXPORT_LINK_TTL    seconds a download link lives (default 900; 60 to 86400).
#   EXPORT_PUBLIC_BASE_URL  if set (e.g. the bridge's public ngrok address), links are also
#                      returned as absolute URLs on this base.
#   MAX_DATASETS       refuse to create once the server hosts this many
#                      (default 50). The backstop, since nothing can drop one.
#
# Fuseki's own default rule admits its /$/ admin API only from the same machine,
# so the bridge and Fuseki should share a host (or the admin API be opened).
# DATASET_CREATORS=alice
# MAX_DATASETS=50
# SNAPSHOT_DIR=C:/holonbridge/snapshots
# SNAPSHOT_MAX_BYTES=50000000
# SNAPSHOT_KEEP=5
# SNAPSHOT_MAX_AGE_DAYS=30
# EXPORT_MAX_BYTES=200000000
# EXPORT_SIGNING_KEY=change-me-to-a-long-random-string-of-32-plus-characters
# EXPORT_LINK_TTL=900
# EXPORT_PUBLIC_BASE_URL=https://your-subdomain.ngrok.io

# --- turtle ---------------------------------------------------------------
# passthrough  Jena parses (required for RDF 1.2 / Turtle 1.2 payloads)
# local        rdflib pre-parses for faster syntax errors; Turtle 1.1 only
PARSE_MODE=passthrough

# --- SHACL gate -----------------------------------------------------------
# When true, every push is validated against urn:{dataset}:shacl.
SHACL_REQUIRED=false
# Delta mode reports only violations the payload introduces. Leave on.
SHACL_DELTA=true

# --- dataset override -----------------------------------------------------
ALLOW_DATASET_OVERRIDE=true

REQUEST_TIMEOUT=60
NAMED_QUERY_TTL=60

# --- scheduler --------------------------------------------------------
# Off by default: it writes on its own initiative, so enabling it is a
# deliberate act. Config always comes from the admin dataset.
SCHEDULER_ENABLED=false
SCHEDULER_DATASET=admin
SCHEDULER_TICK_SECONDS=30
SCHEDULER_MAX_FIRING_DEPTH=3

# --- named-bank config (not env, but lives alongside it) --------------
# ~/.holonbridge/config.json by default; override the path here.
# HOLONBRIDGE_CONFIG=

# Attaches a proposer for LLMInvocation scheduler tasks. Without it they
# record 'deferred' rather than failing. Also used by holonbridge_mcp's
# nl_query tool.
ANTHROPIC_API_KEY=

# =====================================================================
# holonbridge_mcp — the MCP layer (stdio, or remote on port 3032)
# =====================================================================

# --- talking to the REST bridge above --------------------------------
HOLONBRIDGE_URL=http://localhost:3031
# The credential this process presents to the REST bridge: the MCP layer is
# just an HTTP client of it. HOLONBRIDGE_MCP_TOKEN is the MCP's own token (a
# PROXY_TOKENS entry on the bridge; see "one token, one role" above). If it
# is unset or blank this falls back to BEARER_TOKEN, so a setup that shares
# one token between the two keeps working. With neither set, calls carry no
# Authorization header: fine for an open loopback bridge, a 401 "missing
# bearer token" for any other.
HOLONBRIDGE_MCP_TOKEN=

# Optional X-Dataset-Override applied to every call this MCP entry makes;
# a second MCP entry with a different value needs no second bridge process.
# Treated as a deliberate pin: if set, it always wins over whatever dataset
# switch_dataset persisted from a previous session (see
# HOLONBRIDGE_DATASET_STATE_FILE below). Leave unset to let a switch_dataset
# choice survive a restart instead.
HOLONBRIDGE_DATASET=

# switch_dataset persists its choice here so a process restart restores it
# instead of silently reverting to HOLONBRIDGE_DATASET (or nothing) — a
# wrong-dataset write with no warning was a real, repeated failure this
# fixes. Defaults to ~/.holonbridge/mcp-dataset-override; override only if
# you want it somewhere else, e.g. to give two MCP entries on the same
# machine genuinely independent persisted defaults.
# HOLONBRIDGE_DATASET_STATE_FILE=

# Optional bank applied to every call this MCP entry makes, as ?bank=.
# A bank is a named backend connection (server URL + default dataset +
# optional credentials) defined in config.json — formerly called a profile.
# Treated as a deliberate pin exactly like HOLONBRIDGE_DATASET: if set, it
# wins over whatever switch_bank persisted from a previous session. Leave
# unset to let a switch_bank choice survive restarts.
HOLONBRIDGE_BANK=

# switch_bank persists its choice here, for the same reason switch_dataset
# does: a call against the wrong bank still succeeds and still returns data,
# it is simply the wrong store. Defaults to
# ~/.holonbridge/mcp-bank-override; override only if you need to.
# HOLONBRIDGE_BANK_STATE_FILE=

# --- remote transport only (python -m holonbridge_mcp --transport sse) ---
# Static bearer token for the tunnelled endpoint. Independent of
# BEARER_TOKEN above — that one protects :3031, this one protects :3032.
# Refuses to start with neither this nor GitHub OAuth (below) configured.
MCP_INBOUND_TOKEN=

# --- GitHub OAuth, an additional credential kind for the remote transport ---
# Setting GITHUB_OAUTH_CLIENT_ID turns this on; every other var in this
# block then becomes required. See README.md > "GitHub OAuth, as a second
# credential kind" for the full flow and the OAuth App setup step.
#
# MCP_PUBLIC_URL must be the externally reachable base URL (the ngrok URL).
# GitHub redirects back to <MCP_PUBLIC_URL>/callback/github, which must match
# the OAuth App's registered callback exactly. It also feeds the transport
# security allowlist below, so it does double duty — keep it accurate.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
MCP_PUBLIC_URL=
MCP_JWT_SECRET=
MCP_ALLOWED_GITHUB_LOGINS=
# Access-token lifetime. With refresh tokens (below) this can be short, e.g.
# 3600; it bounds how long a lost token or a login removed from the
# allowlist keeps working.
# MCP_JWT_TTL_SECONDS=43200
# Refresh-token lifetime, renewed each time one is used. The allowlist is
# re-checked at every refresh.
# MCP_REFRESH_TTL_SECONDS=2592000
# Directory for the SQLite file holding client registrations and (hashed)
# refresh tokens. Created 0700, file 0600. Unset = in memory: a restart then
# forces every client to re-register and re-authorise. Single host only.
# MCP_DATA_DIR=

# --- transport security ------------------------------------------------
# The MCP SDK's DNS-rebinding protection allows only localhost by default,
# which rejects every request arriving through a tunnel with a
# 421 Misdirected Request ("Invalid Host header"). Note this fires AFTER
# authentication passes, so it looks like an auth failure and isn't one.
# MCP_PUBLIC_URL above is added to the allowlist automatically; set this
# only for an additional host — a second tunnel, a reverse proxy, a custom
# domain. Comma-separated. Protection stays enabled regardless; this
# widens the allowlist rather than switching the check off.
# MCP_ALLOWED_HOSTS=

# =====================================================================
# scripts/holonbridge-ctl.sh only — not read by either Python process
# =====================================================================

# ngrok authtoken for the tunnel scripts/holonbridge-ctl.sh starts.
# CHANGED 2026-08-26: moved here from being hardcoded in the script
# itself. If you're carrying forward a token that was ever committed to
# git, rotate it in the ngrok dashboard (https://dashboard.ngrok.com)
# rather than reusing it — removing it from the script does not remove
# it from git history.
NGROK_AUTHTOKEN=
