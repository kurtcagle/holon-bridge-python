[Unit]
Description=Restart Fuseki for holon-bridge, with rollback of a bad configuration
# No Conflicts= on holonbridge-backup.service: that would STOP a running backup when this unit
# starts, which is the very thing to avoid. The bridge refuses to request a restart while a
# Fuseki backup task is running (/$/tasks), so the two do not overlap in practice.

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/holonbridge-restart-fuseki
# One restart at a time, and give a failed start plus a rollback time to finish.
TimeoutStartSec=300
